// Teste da tela de dicas do G6, sem rede.
// Coloque este arquivo e o dica_g6.h na MESMA pasta "teste_tela_dica".
//
// Botao GPIO35: simula a chegada de uma dica (B4, depois F2, depois F8)
// Botao GPIO0 : volta para "Aguardando dica..." (como quando o G6 fica ativo)

#include <TFT_eSPI.h>
#include "dica_g6.h"

TFT_eSPI tft = TFT_eSPI();

const int BTN_DICA  = 35;
const int BTN_LIMPA = 0;
const char* exemplos[] = {"B4", "f2", " F8 "}; // de proposito com minuscula/espaco
int proxima = 0;

void setup() {
  Serial.begin(115200);
  pinMode(4, OUTPUT); digitalWrite(4, HIGH); // backlight
  pinMode(BTN_DICA, INPUT);
  pinMode(BTN_LIMPA, INPUT_PULLUP);
  tft.init();
  tft.setRotation(3);
  dicaG6_iniciar(tft);
}

void loop() {
  if (digitalRead(BTN_DICA) == LOW) {
    dicaG6_receber(tft, exemplos[proxima % 3]);
    Serial.printf("Dica simulada: %s\n", exemplos[proxima % 3]);
    proxima++;
    delay(400);
  }
  if (digitalRead(BTN_LIMPA) == LOW) {
    dicaG6_iniciar(tft);
    proxima = 0;
    delay(400);
  }
}
